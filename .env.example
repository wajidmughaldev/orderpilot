# ==============================================================================
# OrderPilot Web — Production & Staging Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Transactional Email Provider (Resend via send.orderpilot.pk)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender email address on the send.orderpilot.pk subdomain
EMAIL_FROM="OrderPilot Notifications <notifications@send.orderpilot.pk>"

# Primary recipient email for all website inquiries, demos, and trials
LEAD_RECIPIENT_EMAIL=contact@orderpilot.pk

# ------------------------------------------------------------------------------
# 2. Alternative Transactional Email Providers (Optional)
# ------------------------------------------------------------------------------
# Postmark (https://postmarkapp.com)
# POSTMARK_SERVER_TOKEN=your_postmark_server_token_here

# SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# ------------------------------------------------------------------------------
# 3. Webhook Delivery Relay (CRM, Zapier, Make, Slack, or Regression Testing)
# ------------------------------------------------------------------------------
# When configured, lead payloads (with generated email HTML and text) are dispatched here
# LEAD_DELIVERY_WEBHOOK_URL=https://your-crm-webhook-endpoint.com/leads
# LEAD_WEBHOOK_URL=https://your-crm-webhook-endpoint.com/leads
# LEAD_DELIVERY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting (Upstash Redis or Vercel KV)
# ------------------------------------------------------------------------------
# Required for multi-instance distributed rate limiting across serverless containers
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
# KV_REST_API_URL=https://your-vercel-kv-rest-url.vercel-storage.com
# KV_REST_API_TOKEN=your_vercel_kv_rest_token_here

# Set to "true" only if deployed behind an active Cloudflare proxy with direct origin traffic firewalled
# TRUST_CLOUDFLARE_PROXY=false

